    "import matplotlib.pyplot as plt\n",
    "\n",
    "cells = cells_for_state('california', 6)\n",
    "fig, ax = plt.subplots(figsize=(10,10))\n",
    "ax.axis('off')\n",
    "plot_cells(cells, ax=ax, facecolor='blue', alpha=0.5)\n",
    "plt.show()"
